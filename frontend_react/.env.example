REACT_APP_SANITY_PROJECT_ID=your_project_id

# Optional. A form backend URL (e.g. https://formspree.io/f/xxxxxxx) that accepts
# a JSON POST of { name, email, message }. When unset, the contact form opens
# the visitor's email app with their message pre-filled instead.
REACT_APP_CONTACT_FORM_ENDPOINT=
